{
  "expo": {
    "name": "STT Test",
    "slug": "stt-test",
    "version": "1.0.0",
    "scheme": "stt-test",
    "android": {
      "package": "com.stttest.app",
      "permissions": [
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "برای تست STT به میکروفون نیاز داریم.",
          "speechRecognitionPermission": "برای تست STT به این دسترسی نیاز داریم.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f38e297b-ee32-43a9-a587-0f03866917f6"
      }
    },
    "owner": "m4874923"
  }
}
